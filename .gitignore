# Machine-specific paths (never commit)
LocalPaths.props
LocalPaths.props.user

# Reverse-engineered game code — kept locally as reference, never redistributed.
# Ignore the decompiled contents but keep the explanatory README tracked.
Decompiled/*
!Decompiled/README.md

# Any assets extracted from the player's local game install — never redistributed
ExtractedAssets/

# PoC probe run output (timestamped reports written next to the plugin at runtime)
tools/**/probe-*.txt
ProbeReports/

# Blender working directory. The .blend is OUR authored source for the cave and is tracked; everything
# beside it is local-only — extracted vanilla reference meshes and textures (never redistributed) and
# Blender's own .blend1 save backups. Ignoring the contents rather than the directory is what makes the
# single exception below possible.
BlenderWork/*
!BlenderWork/Falsegods1.blend

# Build output
bin/
obj/

# IDE / scratch
.vs/
.idea/
*.user
.scratch/
